generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
}

enum Size {
  Small
  Medium
  Large
}

enum DogStatus {
  Available
  Pending
  Adopted
}

enum EnergyLevel {
  Low
  Medium
  High
}

enum AdoptionStatus {
  Pending
  InReview
  MeetGreet
  Approved
  Rejected
  Completed
}

enum VolunteerStatus {
  Pending
  Approved
  Rejected
}

enum UserRole {
  admin
  staff
}

enum DonationStatus {
  Pending
  Succeeded
  Failed
  Refunded
}

enum DonationInterval {
  one_time
  monthly
  annual
}

model Dog {
  id           Int       @id @default(autoincrement())
  name         String
  breed        String
  ageMonths    Int       // Age in months (replaces free-form string)
  gender       Gender
  size         Size
  status       DogStatus @default(Available)
  image        String
  tags         String[]  @default([])
  description  String?   // Personality bio
  isNeutered   Boolean   @default(false)
  isVaccinated Boolean   @default(false)
  goodWithKids Boolean   @default(false)
  goodWithDogs Boolean   @default(false)
  goodWithCats Boolean   @default(false)
  energyLevel  EnergyLevel?
  arrivalDate  DateTime?
  adoptionFee  Int?      // In cents (e.g. 5000 = $50.00)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adoptions Adoption[]

  @@index([status, size])
  @@index([breed])
  @@index([status])
  @@index([size])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  dogName   String
  quote     String
  image     String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adoption {
  id            Int             @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  message       String?
  dogId         Int?
  dog           Dog?            @relation(fields: [dogId], references: [id], onDelete: SetNull)
  status        AdoptionStatus  @default(Pending)
  householdType String?         // apartment, house, etc.
  hasYard       Boolean?
  otherPets     String?         // description of other pets
  notes         String?         // Internal staff notes
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([dogId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Content {
  id        Int      @id @default(autoincrement())
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Volunteer {
  id           Int             @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  availability String
  experience   String?
  message      String?
  status       VolunteerStatus @default(Pending)
  notes        String?         // Internal staff notes
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id                     Int              @id @default(autoincrement())
  amount                 Int              // Amount in cents (e.g., 5000 = $50.00)
  currency               String           @default("usd")
  status                 DonationStatus   @default(Pending)
  interval               DonationInterval @default(one_time)
  donorEmail             String?
  donorName              String?
  message                String?          @db.Text
  stripeSessionId        String           @unique
  stripePaymentId        String?          @unique
  stripeSubscriptionId   String?          @unique
  stripeCustomerId       String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([stripeSubscriptionId])
}
