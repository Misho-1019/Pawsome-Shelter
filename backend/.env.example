# =============================================================================
# Pawsome Shelter Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================

# Database
# Get from https://console.neon.tech after creating a project
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# JWT Secret - REQUIRED
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Use a cryptographically random string.
JWT_SECRET=""

# Server
PORT=3001
NODE_ENV=development

# Stripe (test mode) - Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# API URL (used in email unsubscribe links)
# In development: http://localhost:3001
# In production: https://api.pawsomeshelter.com
API_URL="http://localhost:3001"

# Frontend URL (for email links and CORS)
# In development: http://localhost:5173
# In production: https://pawsomeshelter.com
FRONTEND_URL="http://localhost:5173"

# CORS Origin - REQUIRED (comma-separated for multiple)
# In development: http://localhost:5173
# In production: https://pawsomeshelter.com
CORS_ORIGIN="http://localhost:5173"

# CSRF Secret - REQUIRED
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=""

# Admin Credentials - REQUIRED for first-time seeding
# Generate password with: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_EMAIL="admin@pawsomeshelter.com"
ADMIN_PASSWORD=""

# Resend Email Service - OPTIONAL (emails will log to console if not set)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=""
EMAIL_FROM="Pawsome Shelter <noreply@yourdomain.com>"

# Unsubscribe token secret (used to sign newsletter unsubscribe tokens)
# If not set, defaults to JWT_SECRET
UNSUBSCRIBE_SECRET=""
